{
  "name": "spi-jiu-jitsu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "images": "node scripts/images.mjs",
    "predev": "node scripts/fonts.mjs && node scripts/brand.mjs && node scripts/seo.mjs && node scripts/images.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fonts.mjs && node scripts/brand.mjs && node scripts/seo.mjs && node scripts/images.mjs",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "playwright test",
    "screenshots": "playwright test tests/screenshots.spec.ts",
    "brand": "node scripts/brand.mjs",
    "seo": "node scripts/seo.mjs",
    "fonts": "node scripts/fonts.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.12.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
